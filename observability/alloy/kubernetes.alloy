// Grafana Alloy in the local Kubernetes cluster (deploy/k3d/observability, ADR 0010):
// the same pipelines as config.alloy, which does this for docker compose. It tails the
// log files of the VaultGate and dependency pods on this node and ships them to Loki,
// and receives the services' traces over OTLP and forwards them to Tempo.
//
// Runs as a DaemonSet: NODE_NAME is the node it runs on, and /var/log/pods is that
// node's pod log directory, mounted read-only.

discovery.kubernetes "pods" {
	role = "pod"

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		regex         = "vaultgate|vaultgate-deps"
		action        = "keep"
	}

	// The component name (api, gateway, scanner, postgres, ...), as compose's service.
	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		target_label  = "__path__"
		replacement   = "/var/log/pods/*$1/*.log"
	}
}

local.file_match "pods" {
	path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
	targets    = local.file_match.pods.targets
	forward_to = [loki.process.json.receiver]
}

loki.process "json" {
	// The container runtime's line format: time, stream, flags, then the line itself.
	stage.cri { }

	// From here on as with compose: our services log JSON; third-party containers
	// (Postgres, Keycloak) log plain text and keep only the pod labels.
	stage.json {
		expressions = {
			service    = "service",
			level      = "level",
			request_id = "request_id",
			trace_id   = "trace_id",
			ts         = "ts",
		}
	}

	stage.labels {
		values = {
			service = "",
			level   = "",
		}
	}

	stage.structured_metadata {
		values = {
			request_id = "",
			trace_id   = "",
		}
	}

	stage.timestamp {
		source            = "ts"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// --- Traces ------------------------------------------------------------------
// The services export OTLP/HTTP here (OTEL_EXPORTER_OTLP_ENDPOINT=
// https://alloy.monitoring.svc:4318, from the chart's tracing.otlpEndpoint).

// Over TLS (M9, ADR 0012): the certificate from the cluster's CA, which the services'
// exporters verify (OTEL_EXPORTER_OTLP_CERTIFICATE); renewals are read within the hour.
otelcol.receiver.otlp "services" {
	http {
		endpoint = "0.0.0.0:4318"

		tls {
			cert_file       = "/etc/alloy/tls/tls.crt"
			key_file        = "/etc/alloy/tls/tls.key"
			min_version     = "1.2"
			reload_interval = "1h"
		}
	}

	output {
		traces = [otelcol.processor.batch.traces.input]
	}
}

otelcol.processor.batch "traces" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}
