// Grafana Alloy: collects the JSON logs every VaultGate container writes to
// stdout/stderr and ships them to Loki, and receives the services' traces over OTLP
// and forwards them to Tempo (ADR 0008).
//
// Labels stay low-cardinality (service, level, stream). Per-request values such as
// request_id and trace_id travel as structured metadata: searchable, but they never
// create new streams in Loki.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "vaultgate" {
	targets = discovery.docker.containers.targets

	// Only containers of this compose project.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "vaultgate"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.vaultgate.output
	relabel_rules = discovery.relabel.vaultgate.rules
	forward_to    = [loki.process.json.receiver]
}

loki.process "json" {
	// Our services log JSON; third-party containers (Postgres, Keycloak) log plain
	// text and pass through with only the container labels.
	stage.json {
		expressions = {
			service    = "service",
			level      = "level",
			request_id = "request_id",
			trace_id   = "trace_id",
			ts         = "ts",
		}
	}

	// Overrides the compose service name with the log's own "service" field when
	// present; lines without the field keep the compose name.
	stage.labels {
		values = {
			service = "",
			level   = "",
		}
	}

	stage.structured_metadata {
		values = {
			request_id = "",
			trace_id   = "",
		}
	}

	stage.timestamp {
		source            = "ts"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// --- Traces ------------------------------------------------------------------
// The API, gateway and scanner export OTLP/HTTP here (OTEL_EXPORTER_OTLP_ENDPOINT=
// http://alloy:4318). Only HTTP is opened: it is what all three use.

otelcol.receiver.otlp "services" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.processor.batch.traces.input]
	}
}

otelcol.processor.batch "traces" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		// Inside the compose network only.
		tls {
			insecure = true
		}
	}
}
